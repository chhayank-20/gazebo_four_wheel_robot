<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="four_wheel_robot">
    <pose>0 0 0.15 0 0 0</pose>

    <!-- Chassis Link -->
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.2725</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.6625</iyy>
          <iyz>0</iyz>
          <izz>0.8900</izz>
        </inertia>
      </inertial>

      <!-- 1. Main Chassis Hull: Sleek High-Tech Dark Gunmetal -->
      <visual name="chassis_main">
        <geometry>
          <box>
            <size>0.8 0.5 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.16 0.22 1.0</ambient>
          <diffuse>0.18 0.24 0.32 1.0</diffuse>
          <specular>0.7 0.8 0.9 1.0</specular>
        </material>
      </visual>

      <!-- 2. Upper Beveled Avionics Deck -->
      <visual name="chassis_top_deck">
        <pose>0 0 0.082 0 0 0</pose>
        <geometry>
          <box>
            <size>0.68 0.44 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.10 0.14 1.0</ambient>
          <diffuse>0.10 0.14 0.20 1.0</diffuse>
          <specular>0.9 0.9 1.0 1.0</specular>
        </material>
      </visual>

      <!-- 3. Forward Direction Arrow / Chevron (High-Visibility Navigation Heading) -->
      <visual name="heading_indicator_chevron">
        <pose>0.16 0 0.096 0 0 0</pose>
        <geometry>
          <box>
            <size>0.16 0.18 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.85 1.0 1.0</ambient>
          <diffuse>0.0 0.90 1.0 1.0</diffuse>
          <emissive>0.0 0.70 0.95 1.0</emissive>
        </material>
      </visual>

      <!-- 4. Front High-Intensity LED Lightbar -->
      <visual name="front_headlight_bar">
        <pose>0.401 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.012 0.42 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.95 1.0 1.0</ambient>
          <diffuse>0.90 0.98 1.0 1.0</diffuse>
          <emissive>0.75 0.90 1.0 1.0</emissive>
        </material>
      </visual>

      <!-- 5. Rear High-Visibility LED Taillight Strip -->
      <visual name="rear_taillight_bar">
        <pose>-0.401 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>0.012 0.42 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.10 0.10 1.0</ambient>
          <diffuse>0.95 0.10 0.10 1.0</diffuse>
          <emissive>0.85 0.15 0.15 1.0</emissive>
        </material>
      </visual>

      <!-- 6. Left Flank Cyber Accent Strip -->
      <visual name="flank_accent_left">
        <pose>0 0.251 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.72 0.01 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 1.0</ambient>
          <diffuse>0.0 0.85 1.0 1.0</diffuse>
          <emissive>0.0 0.5 0.75 1.0</emissive>
        </material>
      </visual>

      <!-- 7. Right Flank Cyber Accent Strip -->
      <visual name="flank_accent_right">
        <pose>0 -0.251 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.72 0.01 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 1.0</ambient>
          <diffuse>0.0 0.85 1.0 1.0</diffuse>
          <emissive>0.0 0.5 0.75 1.0</emissive>
        </material>
      </visual>

      <!-- Preserved Collision Geometry -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.8 0.5 0.15</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Front Left Wheel Link -->
    <link name="front_left_wheel">
      <pose relative_to="base_link">0.25 0.30 0 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0123</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0225</iyy>
          <iyz>0</iyz>
          <izz>0.0123</izz>
        </inertia>
      </inertial>
      <!-- Outer Rubber Tire -->
      <visual name="tire_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.12 0.12 0.12 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>
      <!-- Metallic Alloy Rim Insert -->
      <visual name="rim_visual">
        <pose>0 0.002 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.095</radius>
            <length>0.082</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.45 0.48 0.52 1.0</ambient>
          <diffuse>0.65 0.70 0.75 1.0</diffuse>
          <specular>0.9 0.9 1.0 1.0</specular>
        </material>
      </visual>
      <!-- Wheel Center Cap Accent -->
      <visual name="hub_cap">
        <pose>0 0.042 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.006</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 1.0</ambient>
          <diffuse>0.0 0.85 1.0 1.0</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.5</mu2>
              <slip1>0.01</slip1>
              <slip2>0.05</slip2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Rear Left Wheel Link -->
    <link name="rear_left_wheel">
      <pose relative_to="base_link">-0.25 0.30 0 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0123</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0225</iyy>
          <iyz>0</iyz>
          <izz>0.0123</izz>
        </inertia>
      </inertial>
      <!-- Outer Rubber Tire -->
      <visual name="tire_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.12 0.12 0.12 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>
      <!-- Metallic Alloy Rim Insert -->
      <visual name="rim_visual">
        <pose>0 0.002 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.095</radius>
            <length>0.082</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.45 0.48 0.52 1.0</ambient>
          <diffuse>0.65 0.70 0.75 1.0</diffuse>
          <specular>0.9 0.9 1.0 1.0</specular>
        </material>
      </visual>
      <!-- Wheel Center Cap Accent -->
      <visual name="hub_cap">
        <pose>0 0.042 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.006</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 1.0</ambient>
          <diffuse>0.0 0.85 1.0 1.0</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.5</mu2>
              <slip1>0.01</slip1>
              <slip2>0.05</slip2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Front Right Wheel Link -->
    <link name="front_right_wheel">
      <pose relative_to="base_link">0.25 -0.30 0 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0123</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0225</iyy>
          <iyz>0</iyz>
          <izz>0.0123</izz>
        </inertia>
      </inertial>
      <!-- Outer Rubber Tire -->
      <visual name="tire_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.12 0.12 0.12 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>
      <!-- Metallic Alloy Rim Insert -->
      <visual name="rim_visual">
        <pose>0 -0.002 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.095</radius>
            <length>0.082</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.45 0.48 0.52 1.0</ambient>
          <diffuse>0.65 0.70 0.75 1.0</diffuse>
          <specular>0.9 0.9 1.0 1.0</specular>
        </material>
      </visual>
      <!-- Wheel Center Cap Accent -->
      <visual name="hub_cap">
        <pose>0 -0.042 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.006</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 1.0</ambient>
          <diffuse>0.0 0.85 1.0 1.0</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.5</mu2>
              <slip1>0.01</slip1>
              <slip2>0.05</slip2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Rear Right Wheel Link -->
    <link name="rear_right_wheel">
      <pose relative_to="base_link">-0.25 -0.30 0 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0123</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0225</iyy>
          <iyz>0</iyz>
          <izz>0.0123</izz>
        </inertia>
      </inertial>
      <!-- Outer Rubber Tire -->
      <visual name="tire_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1.0</ambient>
          <diffuse>0.12 0.12 0.12 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>
      <!-- Metallic Alloy Rim Insert -->
      <visual name="rim_visual">
        <pose>0 -0.002 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.095</radius>
            <length>0.082</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.45 0.48 0.52 1.0</ambient>
          <diffuse>0.65 0.70 0.75 1.0</diffuse>
          <specular>0.9 0.9 1.0 1.0</specular>
        </material>
      </visual>
      <!-- Wheel Center Cap Accent -->
      <visual name="hub_cap">
        <pose>0 -0.042 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.006</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.7 0.9 1.0</ambient>
          <diffuse>0.0 0.85 1.0 1.0</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.5</mu2>
              <slip1>0.01</slip1>
              <slip2>0.05</slip2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- Joints -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <!-- 2D LiDAR Link -->
    <link name="laser_link">
      <pose relative_to="base_link">0.25 0 0.16 0 0 0</pose>
      <inertial>
        <mass>0.125</mass>
        <inertia>
          <ixx>0.000185</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000185</iyy>
          <iyz>0</iyz>
          <izz>0.00025</izz>
        </inertia>
      </inertial>

      <!-- LiDAR Base Pedestal -->
      <visual name="lidar_pedestal">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.14 0.18 1.0</ambient>
          <diffuse>0.18 0.22 0.28 1.0</diffuse>
          <specular>0.6 0.6 0.7 1.0</specular>
        </material>
      </visual>

      <!-- LiDAR Rotating Sensor Drum Head -->
      <visual name="lidar_sensor_head">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.052</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.06 0.08 0.10 1.0</ambient>
          <diffuse>0.10 0.12 0.15 1.0</diffuse>
          <specular>0.9 0.9 1.0 1.0</specular>
        </material>
      </visual>

      <!-- LiDAR 360-Degree Optical Aperture Ring (Vivid Cyan Sensor Glow) -->
      <visual name="lidar_aperture_ring">
        <pose>0 0 0.002 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.054</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.85 0.95 1.0</ambient>
          <diffuse>0.0 0.95 1.0 1.0</diffuse>
          <emissive>0.0 0.80 0.90 1.0</emissive>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.03 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <gz_frame_id>laser_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.10</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="base_link_to_laser_joint" type="fixed">
      <parent>base_link</parent>
      <child>laser_link</child>
    </joint>

    <!-- Native Gazebo Sim DiffDrive Plugin (Skid Steer 4-Wheel Drive actuation) -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.60</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <max_linear_acceleration>3.0</max_linear_acceleration>
      <min_linear_acceleration>-3.0</min_linear_acceleration>
      <max_angular_acceleration>6.0</max_angular_acceleration>
      <min_angular_acceleration>-6.0</min_angular_acceleration>
      <max_linear_velocity>1.5</max_linear_velocity>
      <min_linear_velocity>-1.5</min_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity>
      <min_angular_velocity>-3.0</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/model/four_wheel_robot/wheel_odom</odom_topic>
      <tf_topic>/model/four_wheel_robot/wheel_tf</tf_topic>
      <frame_id>wheel_odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>

    <!-- Ground-truth Odometry Publisher (Phase 1 stabilization) -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/model/four_wheel_robot/tf</tf_topic>
      <dimensions>2</dimensions>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>

  </model>
</sdf>

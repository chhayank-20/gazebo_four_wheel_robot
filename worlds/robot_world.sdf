<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="robot_world">

    <!-- Physics settings -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Presentation Scene & Global Ambient Properties -->
    <scene>
      <ambient>0.62 0.64 0.68 1.0</ambient>
      <background>0.12 0.14 0.18 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Main Architectural Sunlight (Soft Angle with Fill) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>-10 0 25 0 0 0</pose>
      <diffuse>0.65 0.65 0.68 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.2 0.2 -0.9</direction>
    </light>

    <!-- Interior Ceiling Lighting: Reception Lobby -->
    <light type="point" name="light_lobby">
      <cast_shadows>false</cast_shadows>
      <pose>-1.8 2.5 3.5 0 0 0</pose>
      <diffuse>0.92 0.90 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Interior Ceiling Lighting: Executive Board Room -->
    <light type="point" name="light_board_room">
      <cast_shadows>false</cast_shadows>
      <pose>-26.68 10.88 3.5 0 0 0</pose>
      <diffuse>0.90 0.92 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Interior Ceiling Lighting: Living Demo Lounge -->
    <light type="point" name="light_living_demo">
      <cast_shadows>false</cast_shadows>
      <pose>1.10 10.88 3.5 0 0 0</pose>
      <diffuse>0.96 0.90 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Interior Ceiling Lighting: Hotel Experience Suite -->
    <light type="point" name="light_hotel_exp">
      <cast_shadows>false</cast_shadows>
      <pose>-8.41 10.88 3.5 0 0 0</pose>
      <diffuse>0.95 0.88 0.80 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Interior Ceiling Lighting: Healthcare Demo Room -->
    <light type="point" name="light_hospital_exp">
      <cast_shadows>false</cast_shadows>
      <pose>-8.04 3.29 3.5 0 0 0</pose>
      <diffuse>0.92 0.96 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>14</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Interior Ceiling Lighting: Main West Corridor -->
    <light type="point" name="light_corridor_west">
      <cast_shadows>false</cast_shadows>
      <pose>-25.0 7.25 3.5 0 0 0</pose>
      <diffuse>0.90 0.90 0.94 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>18</range>
        <constant>0.3</constant>
        <linear>0.04</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
    </light>

    <!-- Interior Ceiling Lighting: Main East Corridor -->
    <light type="point" name="light_corridor_east">
      <cast_shadows>false</cast_shadows>
      <pose>16.0 7.25 3.5 0 0 0</pose>
      <diffuse>0.90 0.90 0.94 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>18</range>
        <constant>0.3</constant>
        <linear>0.04</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
    </light>

    <!-- Ground Plane (Modern Architectural Charcoal/Slate Finish) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>150 150</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>150 150</size></plane></geometry>
          <material>
            <ambient>0.25 0.26 0.28 1</ambient>
            <diffuse>0.32 0.33 0.36 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Office Architecture & Detailed Interior Zones -->
    <include>
      <uri>package://models/office_environment</uri>
      <name>office_environment</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Four-Wheel Robot Model starting in Lobby IN lane -->
    <include>
      <uri>package://models/four_wheel_robot</uri>
      <name>four_wheel_robot</name>
      <pose>-1.8 0.0 0.15 0 0 1.5708</pose>
    </include>

  </world>
</sdf>

<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="robot_world">

    <!-- Physics settings -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential System Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Arena Boundary Walls (12m x 12m perimeter) -->
    <model name="boundary_walls">
      <static>true</static>
      <!-- North Wall -->
      <link name="north_wall">
        <pose>3.0 6.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>12.0 0.2 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12.0 0.2 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.55 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South Wall -->
      <link name="south_wall">
        <pose>3.0 -6.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>12.0 0.2 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12.0 0.2 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.55 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- West Wall -->
      <link name="west_wall">
        <pose>-3.0 0.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 12.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 12.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.55 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- East Wall -->
      <link name="east_wall">
        <pose>9.0 0.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 12.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 12.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.55 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Indoor Corridor Walls -->
    <model name="corridor_walls">
      <static>true</static>
      <!-- North Corridor Wall (from X=-2.0 to X=4.5 at Y=2.0) -->
      <link name="corridor_north">
        <pose>1.25 2.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>6.5 0.2 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6.5 0.2 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.7 1</ambient>
            <diffuse>0.65 0.65 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South Corridor Wall (from X=-2.0 to X=4.5 at Y=-2.0) -->
      <link name="corridor_south">
        <pose>1.25 -2.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>6.5 0.2 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6.5 0.2 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.7 1</ambient>
            <diffuse>0.65 0.65 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 1: Corridor Intervening Obstacle (Red Box) -->
    <!-- Directly blocks straight path from (0, 0) to (5.0, 0.0) -->
    <model name="obstacle_corridor_block">
      <static>true</static>
      <pose>2.5 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.2 0.2 1</ambient>
            <diffuse>0.85 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: North Atrium Column (Green Cylinder) -->
    <model name="obstacle_atrium_column">
      <static>true</static>
      <pose>5.5 2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.75 0.3 1</ambient>
            <diffuse>0.2 0.75 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: East Corridor Buffer (Yellow Box) -->
    <model name="obstacle_east_buffer">
      <static>true</static>
      <pose>7.0 -0.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.8 0.2 1</ambient>
            <diffuse>0.85 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Deliberately Enclosed / Blocked Room (No Doorway) -->
    <!-- Inside center: (1.5, -4.0) - Completely impassable from all sides -->
    <model name="blocked_chamber">
      <static>true</static>
      <link name="chamber_west">
        <pose>0.0 -4.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 3.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 3.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.35 0.5 1</ambient>
            <diffuse>0.3 0.35 0.5 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="chamber_east">
        <pose>3.0 -4.0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 3.0 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 3.0 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.35 0.5 1</ambient>
            <diffuse>0.3 0.35 0.5 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="chamber_north">
        <pose>1.5 -2.5 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>3.2 0.2 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.2 0.2 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.35 0.5 1</ambient>
            <diffuse>0.3 0.35 0.5 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="chamber_south">
        <pose>1.5 -5.5 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>3.2 0.2 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.2 0.2 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.35 0.5 1</ambient>
            <diffuse>0.3 0.35 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Four-Wheel Robot Model -->
    <include>
      <uri>package://models/four_wheel_robot</uri>
      <name>four_wheel_robot</name>
      <pose>0 0 0.15 0 0 0</pose>
    </include>

  </world>
</sdf>

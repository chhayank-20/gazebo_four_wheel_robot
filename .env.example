# ==============================================================================
# Office Autonomous Robot Control API - Environment Configuration Example
# Copy this file to .env and configure your desired provider.
# NEVER commit your actual API keys or secrets to Git.
# ==============================================================================

# LLM Provider Configuration
# Supported providers: mock | openai | gemini | anthropic
LLM_PROVIDER=mock

# Model Identifier
# Examples:
#   OpenAI:    gpt-4o-mini, gpt-4o
#   Gemini:    gemini-1.5-flash, gemini-1.5-pro
#   Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
#   Mock:      mock-robot-llm-v1
LLM_MODEL=mock-robot-llm-v1

# API Key (leave empty or use placeholder when LLM_PROVIDER=mock)
LLM_API_KEY=your_api_key_here

# Optional: Dedicated Provider API Keys (alternative to LLM_API_KEY)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Custom API Base URL (for local models, Ollama, vLLM, OpenRouter)
# LLM_BASE_URL=https://api.openai.com/v1

# HTTP Request Timeout (seconds)
LLM_TIMEOUT_SECONDS=15.0

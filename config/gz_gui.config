<?xml version="1.0"?>
<gui>
  <!-- Window properties: Full 16:9 HD resolution without editor margins -->
  <dialog name="quick_start" show_again="false"/>

  <window>
    <width>1280</width>
    <height>720</height>
    <style
      material_theme="Dark"
      material_primary="Blue"
      material_accent="Cyan"
      toolbar_color_dark="#1e293b"
      toolbar_text_color_dark="#f8fafc"
      plugin_toolbar_color_dark="#0f172a"
      plugin_toolbar_text_color_dark="#f8fafc"
    />
    <menus>
      <drawer default="false">
      </drawer>
    </menus>
    <dialog_on_exit>false</dialog_on_exit>
  </window>

  <!-- Clean 3D Viewport: docked to 100% of the canvas -->
  <plugin filename="MinimalScene" name="3D View">
    <gz-gui>
      <title>3D View</title>
      <property type="bool" key="showTitleBar">false</property>
      <property type="string" key="state">docked</property>
    </gz-gui>
    <engine>ogre2</engine>
    <scene>scene</scene>
    <ambient_light>0.55 0.55 0.55</ambient_light>
    <background_color>0.10 0.12 0.16</background_color>
    <camera_pose>-1.8 -6.0 5.5 0 0.52 1.57</camera_pose>
  </plugin>

  <!-- Interactive camera navigation: pan, tilt, zoom -->
  <plugin filename="InteractiveViewControl" name="Interactive view control">
    <gz-gui>
      <property key="resizable" type="bool">false</property>
      <property key="width" type="double">5</property>
      <property key="height" type="double">5</property>
      <property key="state" type="string">floating</property>
      <property key="showTitleBar" type="bool">false</property>
    </gz-gui>
  </plugin>

  <!-- Camera follow tracking service for chase cam -->
  <plugin filename="CameraTracking" name="Camera Tracking">
    <gz-gui>
      <property key="resizable" type="bool">false</property>
      <property key="width" type="double">5</property>
      <property key="height" type="double">5</property>
      <property key="state" type="string">floating</property>
      <property key="showTitleBar" type="bool">false</property>
    </gz-gui>
  </plugin>

  <!-- Marker manager for trajectory visuals -->
  <plugin filename="MarkerManager" name="Marker manager">
    <gz-gui>
      <property key="resizable" type="bool">false</property>
      <property key="width" type="double">5</property>
      <property key="height" type="double">5</property>
      <property key="state" type="string">floating</property>
      <property key="showTitleBar" type="bool">false</property>
    </gz-gui>
  </plugin>

  <!-- Select Entities -->
  <plugin filename="SelectEntities" name="Select Entities">
    <gz-gui>
      <property key="resizable" type="bool">false</property>
      <property key="width" type="double">5</property>
      <property key="height" type="double">5</property>
      <property key="state" type="string">floating</property>
      <property key="showTitleBar" type="bool">false</property>
    </gz-gui>
  </plugin>

  <!-- Visualization Capabilities -->
  <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
    <gz-gui>
      <property key="resizable" type="bool">false</property>
      <property key="width" type="double">5</property>
      <property key="height" type="double">5</property>
      <property key="state" type="string">floating</property>
      <property key="showTitleBar" type="bool">false</property>
    </gz-gui>
  </plugin>
</gui>
